# Copy to .env for local development. Never commit real values.
PORT=3100
BASE_URL=http://localhost:3100

# Local development: leave FIRESTORE_DATABASE_ID unset to use the in-memory store,
# and turn on demo connections so you can try the flow without platform keys.
DEMO_MODE=true
ADMIN_EMAILS=you@example.com
INTERNAL_SECRET=dev-secret

# Production
# FIRESTORE_DATABASE_ID=creatortrack
# FIREBASE_PROJECT_ID=omnitrack-507708
# TOKEN_ENCRYPTION_KEY=   # openssl rand -base64 32
# RESEND_API_KEY=
# EMAIL_FROM=CreatorTrack <hello@creatortrack.lk>
# GOOGLE_CLIENT_ID=        # Google sign-in + YouTube
# GOOGLE_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
