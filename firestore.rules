rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All application data is read and written exclusively by the backend
    // server via the Firebase Admin SDK, which bypasses these rules. No
    // client (web/mobile) should ever access Firestore directly, so every
    // collection is closed to client SDK access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
